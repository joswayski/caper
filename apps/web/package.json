    "@tanstack/react-start": "^1.168.46",
    "@twemoji/svg": "^15.0.0",
    "emoji-picker-react": "^4.22.3",
    "lucide-react": "^0.468.0",
    "nitro": "3.0.260610-beta",
    "onnxruntime-web": "1.23.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-virtuoso": "^4.18.14",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
