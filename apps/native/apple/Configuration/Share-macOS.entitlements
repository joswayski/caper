<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App extensions must be sandboxed. sign-and-notarize.sh adds the team-prefixed
	     App Group it shares with Caper.app when signing with Developer ID. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
