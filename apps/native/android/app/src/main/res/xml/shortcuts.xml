<?xml version="1.0" encoding="utf-8"?>
<!-- Sharing Shortcuts: recent conversations ShareShortcuts.kt publishes appear as
     direct targets in the system share sheet and open ShareActivity with their ID. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="chat.caper.android.ShareActivity">
        <data android:mimeType="*/*" />
        <category android:name="chat.caper.android.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
