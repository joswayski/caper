# Server-only configuration. Never prefix credentials with VITE_ or commit values.
# API startup migrations: direct URL on port 5432, database /caperchat, verified TLS.
# Use a separate migration role in hosted environments. Startup grants the runtime
# role access to migrated application tables. Both URLs belong only in the API.
MIGRATION_DATABASE_URL=
# DATABASE_URL below is runtime-only: pooled port 6432 for hosted environments.
# Startup migrates via MIGRATION_DATABASE_URL before serving; no Job required.
# Loopback development URLs may explicitly use sslmode=disable.
DATABASE_URL=
# Account login stays disabled when AUTH_SECRET is empty. Generate at least 32
# random bytes, store it only server-side, and keep it stable across API replicas.
AUTH_SECRET=
AUTH_CODE_ATTEMPTS=3
# Optional comma-separated username allowlist for authenticated client diagnostics.
# Server-only; entries are trimmed and matched exactly, case-insensitively. Blank disables.
DEBUG_USERS=
# Additional reserved account usernames (caper, capers, admin, admins, mod,
# mods, support, feedback, security, staff, jose, caperchat, aaron, and
# joswayski are always reserved).
# Server-only; comma-separated, trimmed, case-insensitive. Restart API after changes.
RESERVED_USERNAMES=
AUTH_EMAIL_15M_LIMIT=3
AUTH_EMAIL_DAILY_LIMIT=5
AUTH_IP_HOURLY_LIMIT=10
AUTH_GLOBAL_HOURLY_LIMIT=500
# Positive integer quotas. Owned spaces count toward total memberships.
# Restart API replicas after changing; existing resources are not removed.
SPACE_OWNED_LIMIT=20
SPACE_MEMBERSHIP_LIMIT=100
SPACE_CHANNEL_LIMIT=100
# Optional HTTPS endpoint for best-effort application notifications. Keep the URL
# server-only; `user.created` is posted only after a new account commits.
NOTIFICATIONS_WEBHOOK_URL=
# Phone push (APNs, FCM) for DMs and channel messages; see docs/notifications.md.
# Off unless true, and needs CHAT_ENABLED. A platform (apns, apnsSandbox, fcm) is
# advertised only when listed in PUSH_PLATFORMS and its credentials load. Store
# real keys with scripts/store-push-credentials.sh, never here.
NOTIFICATIONS_ENABLED=false
PUSH_PLATFORMS=
APNS_TEAM_ID=
# APNs .p8 PEM keys; real newlines or \n escapes. Production and sandbox are separate.
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_SANDBOX_KEY_ID=
APNS_SANDBOX_PRIVATE_KEY=
# Bundle ID; defaults to chat.caper.ios.
APNS_TOPIC=
# Firebase service-account JSON key, as one string.
FCM_SERVICE_ACCOUNT_JSON=
AWS_REGION=us-east-1
SES_FROM_ADDRESS=Caper <noreply@staging.caper.chat>
SES_CONFIGURATION_SET=staging-caper-transactional
MEDIA_ENABLED=false
MEDIA_BIND=0.0.0.0:3001
# Messaging for account channels. Requires Postgres and Valkey.
# Channels require membership; the homepage simulation uses no backend services.
# Run the same API image with --gateway for live events, independently of API.
CHAT_ENABLED=false
CHAT_GATEWAY_BIND=0.0.0.0:3002
# Activity timeout, not connection expiry. Ten minutes by default.
PRESENCE_IDLE_TIMEOUT_SECONDS=600
# Admission bound per gateway pod; size replicas to measured CPU/memory budgets.
GATEWAY_MAX_CONNECTIONS=4096
# Server-only shared call state. Compose defaults to its local Valkey service.
# Outside Compose, empty keeps single-process development mode.
# Hosted endpoints require rediss://username:password@host:6379 (verified TLS).
VALKEY_URL=
CF_SFU_APP_ID=
CF_SFU_APP_SECRET=
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
DATABASE_URL=
RUST_LOG=caper_api=info,tower_http=info
LOG_FORMAT=json
ENVIRONMENT=development
# Optional Rust API log export. Ingest-only token; never expose it to the browser.
AXIOM_TOKEN=
AXIOM_DATASET=caper
# Set the dataset's actual Axiom edge URL, including /v1/logs. No region is assumed.
AXIOM_ENDPOINT=
