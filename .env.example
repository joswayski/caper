# Server-only configuration. Never prefix credentials with VITE_ or commit values.
# Both servers use the same WorkOS environment; no paid custom domain required.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Web only: generate a random >=32-character secret, shared across replicas.
WORKOS_COOKIE_PASSWORD=
# Exact registered HTTPS callback URL, ending in /api/auth/callback.
WORKOS_REDIRECT_URI=
# Migration command only: direct URL on port 5432, database /caperchat, verified TLS.
# Use a separate migration role; do not inject this into the running API.
MIGRATION_DATABASE_URL=
# DATABASE_URL below is runtime-only: pooled port 6432, database /caperchat.
# Normal API startup never applies migrations.
MEDIA_ENABLED=false
MEDIA_BIND=0.0.0.0:3001
MEDIA_API_URL=http://127.0.0.1:3001
CF_SFU_APP_ID=
CF_SFU_APP_SECRET=
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
DATABASE_URL=
RUST_LOG=caper_api=info,tower_http=info
LOG_FORMAT=json
ENVIRONMENT=development
# Optional Rust API log export. Ingest-only token; never expose it to the browser.
AXIOM_TOKEN=
AXIOM_DATASET=caper
# Set the dataset's actual Axiom edge URL, including /v1/logs. No region is assumed.
AXIOM_ENDPOINT=
