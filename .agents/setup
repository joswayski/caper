#!/usr/bin/env bash
set -euo pipefail

# Browser/API and native desktop build prerequisites. No Cloudflare credentials
# or audio devices are seeded; physical voice acceptance remains separate.
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step_started=$SECONDS
step() {
  printf '[setup] %s (%ss)\n' "$1" "$((SECONDS - step_started))"
  step_started=$SECONDS
}

step "checking Linux build dependencies"
if ! command -v clang-21 >/dev/null 2>&1 || ! command -v ld.lld-21 >/dev/null 2>&1; then
  # The pinned WebRTC archive's Chromium libc++ headers need Clang 21.
  # Restrict this signing key to LLVM's versioned Debian 12 repository.
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error --retry 3 \
    https://apt.llvm.org/llvm-snapshot.gpg.key \
    | sudo tee /usr/share/keyrings/caper-llvm.asc >/dev/null
  printf '%s\n' 'deb [signed-by=/usr/share/keyrings/caper-llvm.asc] https://apt.llvm.org/bookworm/ llvm-toolchain-bookworm-21 main' \
    | sudo tee /etc/apt/sources.list.d/caper-llvm.list >/dev/null
fi
packages=(
  build-essential
  clang-21
  curl
  file
  gnome-keyring
  libasound2
  libasound2-dev
  libdbus-1-dev
  libegl1-mesa-dev
  libgl1-mesa-dri
  libglib2.0-dev
  libpulse0
  librsvg2-bin
  libssl-dev
  libwayland-dev
  libx11-dev
  libxcursor-dev
  libxi-dev
  libxkbcommon-dev
  libxkbcommon-x11-0
  libxrandr-dev
  lld-21
  openjdk-17-jdk-headless
  pkg-config
  postgresql
  openbox
  unzip
  x11-utils
  xauth
  xdotool
  xvfb
)
missing_packages=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
    missing_packages+=("$package")
  fi
done
if ((${#missing_packages[@]} > 0)); then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing_packages[@]}"
fi

step "installing Valkey 9.1.2"
valkey_version="9.1.2"
case "$(uname -m)" in
  x86_64)
    valkey_arch="x86_64"
    valkey_sha256="33687af7a5457459a16c207a9c1971fc70f67e6ec1f011a876094b790741bd63"
    ;;
  aarch64 | arm64)
    valkey_arch="arm64"
    valkey_sha256="a3dcac64815b2ed907b3942343ba51f34877de2d58e809435226f6b03686a5a1"
    ;;
  *)
    printf 'Unsupported architecture for Valkey: %s\n' "$(uname -m)" >&2
    exit 1
    ;;
esac
valkey_install_dir="/opt/valkey-${valkey_version}-jammy-${valkey_arch}"
if [[ ! -x "$valkey_install_dir/bin/valkey-server" ]]; then
  valkey_archive="$(mktemp)"
  trap 'rm -f "$valkey_archive"' EXIT
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
    --output "$valkey_archive" \
    "https://download.valkey.io/releases/valkey-${valkey_version}-jammy-${valkey_arch}.tar.gz"
  printf '%s  %s\n' "$valkey_sha256" "$valkey_archive" | sha256sum --check --status
  sudo tar --extract --gzip --file "$valkey_archive" --directory /opt
  rm -f "$valkey_archive"
  trap - EXIT
fi
for executable in "$valkey_install_dir"/bin/valkey-*; do
  sudo ln -sfn "$executable" "/usr/local/bin/${executable##*/}"
done

step "checking Android build tools"
# Google's Linux build tools target x86_64. Do not install an emulator: orbs
# have no KVM, and compiling UI tests is not a physical-device check.
if [[ "$(uname -m)" == x86_64 ]]; then
  export ANDROID_HOME="${ANDROID_HOME:-$HOME/.local/share/caper/android-sdk}"
  android_tools_version="22.0"
  android_tools="$ANDROID_HOME/cmdline-tools/$android_tools_version"
  if [[ ! -x "$android_tools/bin/sdkmanager" ]]; then
    android_download="$(mktemp -d)"
    trap 'rm -rf "$android_download"' EXIT
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
      https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip \
      --output "$android_download/tools.zip"
    printf '%s  %s\n' '4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583' \
      "$android_download/tools.zip" | sha256sum --check --status
    unzip -q "$android_download/tools.zip" -d "$android_download"
    mkdir -p "$(dirname "$android_tools")"
    mv "$android_download/cmdline-tools" "$android_tools"
    rm -rf "$android_download"
    trap - EXIT
  fi
  # The app's build file, not a second set of pins, defines the SDK components.
  android_build="$repo_root/apps/native/android/app/build.gradle.kts"
  android_compile_sdk="$(sed -n 's/^ *compileSdk = \([0-9]*\)$/\1/p' "$android_build")"
  android_build_tools="$(sed -n 's/^ *buildToolsVersion = "\([^"]*\)"$/\1/p' "$android_build")"
  android_ndk="$(sed -n 's/^ *ndkVersion = "\([^"]*\)"$/\1/p' "$android_build")"
  android_cmake="$(sed -n 's/.*externalNativeBuild { cmake {.*version = "\([^"]*\)".*/\1/p' "$android_build")"
  : "${android_compile_sdk:?Missing compileSdk}" "${android_build_tools:?Missing buildToolsVersion}" \
    "${android_ndk:?Missing ndkVersion}" "${android_cmake:?Missing CMake version}"
  android_packages=(platform-tools "platforms;android-$android_compile_sdk" \
    "build-tools;$android_build_tools" "ndk;$android_ndk" "cmake;$android_cmake")
  android_missing=()
  for package in "${android_packages[@]}"; do
    if [[ ! -f "$ANDROID_HOME/${package//;/\/}/package.xml" ]]; then
      android_missing+=("$package")
    fi
  done
  if ((${#android_missing[@]} > 0)); then
    # yes exits on SIGPIPE when sdkmanager is done; preserve sdkmanager's status.
    (set +o pipefail; yes | "$android_tools/bin/sdkmanager" --sdk_root="$ANDROID_HOME" --licenses >/dev/null)
    "$android_tools/bin/sdkmanager" --sdk_root="$ANDROID_HOME" "${android_missing[@]}"
  fi
  # Amp and supervised services use fresh login shells after setup exits.
  # Restrict activation to this checkout and leave a caller's SDK override alone.
  android_profile_marker="# Caper Android SDK: $repo_root"
  if ! grep -Fqx "$android_profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    {
      printf '\n%s\n' "$android_profile_marker"
      printf 'if [[ "$PWD" == %q || "$PWD" == %q/* ]]; then\n' "$repo_root" "$repo_root"
      printf '  if [[ -z "${ANDROID_HOME:-}" ]]; then export ANDROID_HOME=%q; fi\n' "$ANDROID_HOME"
      printf '  export PATH="$ANDROID_HOME/cmdline-tools/%s/bin:$ANDROID_HOME/platform-tools:$PATH"\nfi\n' "$android_tools_version"
    } >> "$HOME/.bash_profile"
  fi
else
  printf '[setup] Android SDK skipped: Linux build tools require x86_64\n'
fi

step "checking Node.js and npm"
if ! command -v npm >/dev/null 2>&1; then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs npm
fi
node_major="$(node -p 'process.versions.node.split(".")[0]')"
if ((node_major != 24)); then
  npm install --global n
  n 24
  hash -r
fi
npm_major="$(npm --version | cut -d. -f1)"
if ((npm_major < 11)); then
  npm install --global npm@11
  hash -r
fi

step "installing Rust 1.94.0"
if [[ -f "$HOME/.cargo/env" ]]; then
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi
if ! command -v rustup >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain none
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi
rustup toolchain install 1.94.0 --profile minimal --component rustfmt --component clippy

step "installing JavaScript dependencies"
npm ci

step "installing locked Python tooling"
uv_version="$(sed -n 's/^required-version = "==\([^"]*\)"/\1/p' pyproject.toml)"
if ! command -v uv >/dev/null 2>&1 || [[ "$(uv --version | awk '{print $2}')" != "$uv_version" ]]; then
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
    "https://astral.sh/uv/$uv_version/install.sh" | env UV_NO_MODIFY_PATH=1 sh
  export PATH="$HOME/.local/bin:$PATH"
fi
uv sync --locked

step "fetching Rust dependencies"
cargo fetch --locked

step "complete"
printf '[setup] Node %s, npm %s, Rust %s, Valkey %s\n' \
  "$(node --version)" \
  "$(npm --version)" \
  "$(rustc --version | awk '{print $2}')" \
  "$(valkey-server --version | sed -n 's/.* v=\([^ ]*\).*/\1/p')"
