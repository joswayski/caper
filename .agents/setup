#!/usr/bin/env bash
set -euo pipefail

# Browser/API and native desktop build prerequisites. No Cloudflare credentials
# or audio devices are seeded; physical voice acceptance remains separate.
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step_started=$SECONDS
step() {
  printf '[setup] %s (%ss)\n' "$1" "$((SECONDS - step_started))"
  step_started=$SECONDS
}

step "checking Linux build dependencies"
if ! command -v clang-21 >/dev/null 2>&1 || ! command -v ld.lld-21 >/dev/null 2>&1; then
  # The pinned WebRTC archive's Chromium libc++ headers need Clang 21.
  # Restrict this signing key to LLVM's versioned Debian 12 repository.
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error --retry 3 \
    https://apt.llvm.org/llvm-snapshot.gpg.key \
    | sudo tee /usr/share/keyrings/caper-llvm.asc >/dev/null
  printf '%s\n' 'deb [signed-by=/usr/share/keyrings/caper-llvm.asc] https://apt.llvm.org/bookworm/ llvm-toolchain-bookworm-21 main' \
    | sudo tee /etc/apt/sources.list.d/caper-llvm.list >/dev/null
fi
packages=(
  build-essential
  clang-21
  curl
  file
  libasound2
  libdbus-1-dev
  libegl1-mesa-dev
  libglib2.0-dev
  libpulse0
  libssl-dev
  libwayland-dev
  libx11-dev
  libxcursor-dev
  libxi-dev
  libxkbcommon-dev
  libxrandr-dev
  lld-21
  pkg-config
  postgresql
)
missing_packages=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
    missing_packages+=("$package")
  fi
done
if ((${#missing_packages[@]} > 0)); then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing_packages[@]}"
fi

step "installing Valkey 9.1.2"
valkey_version="9.1.2"
case "$(uname -m)" in
  x86_64)
    valkey_arch="x86_64"
    valkey_sha256="33687af7a5457459a16c207a9c1971fc70f67e6ec1f011a876094b790741bd63"
    ;;
  aarch64 | arm64)
    valkey_arch="arm64"
    valkey_sha256="a3dcac64815b2ed907b3942343ba51f34877de2d58e809435226f6b03686a5a1"
    ;;
  *)
    printf 'Unsupported architecture for Valkey: %s\n' "$(uname -m)" >&2
    exit 1
    ;;
esac
valkey_install_dir="/opt/valkey-${valkey_version}-jammy-${valkey_arch}"
if [[ ! -x "$valkey_install_dir/bin/valkey-server" ]]; then
  valkey_archive="$(mktemp)"
  trap 'rm -f "$valkey_archive"' EXIT
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
    --output "$valkey_archive" \
    "https://download.valkey.io/releases/valkey-${valkey_version}-jammy-${valkey_arch}.tar.gz"
  printf '%s  %s\n' "$valkey_sha256" "$valkey_archive" | sha256sum --check --status
  sudo tar --extract --gzip --file "$valkey_archive" --directory /opt
  rm -f "$valkey_archive"
  trap - EXIT
fi
for executable in "$valkey_install_dir"/bin/valkey-*; do
  sudo ln -sfn "$executable" "/usr/local/bin/${executable##*/}"
done

step "checking Node.js and npm"
if ! command -v npm >/dev/null 2>&1; then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs npm
fi
node_major="$(node -p 'process.versions.node.split(".")[0]')"
if ((node_major != 24)); then
  npm install --global n
  n 24
  hash -r
fi
npm_major="$(npm --version | cut -d. -f1)"
if ((npm_major < 11)); then
  npm install --global npm@11
  hash -r
fi

step "installing Rust 1.94.0"
if [[ -f "$HOME/.cargo/env" ]]; then
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi
if ! command -v rustup >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain none
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi
rustup toolchain install 1.94.0 --profile minimal --component rustfmt --component clippy

step "installing JavaScript dependencies"
npm ci

step "fetching Rust dependencies"
cargo fetch --locked

step "complete"
printf '[setup] Node %s, npm %s, Rust %s, Valkey %s\n' \
  "$(node --version)" \
  "$(npm --version)" \
  "$(rustc --version | awk '{print $2}')" \
  "$(valkey-server --version | sed -n 's/.* v=\([^ ]*\).*/\1/p')"
