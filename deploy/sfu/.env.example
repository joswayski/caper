# Copy to .env on the host (mode 0600). Never commit real values.
SFU_IMAGE=ghcr.io/joswayski/caper-sfu:<full-40-character-sha>
SFU_DOMAIN=sfu.caper.chat
SFU_PUBLIC_IP=<Lightsail static IP>
# The instance's own address behind Lightsail's 1:1 NAT: hostname -I | awk '{print $1}'
SFU_PRIVATE_IP=<private IP>
# The Caper API's CF_SFU_APP_ID / CF_SFU_APP_SECRET / CF_TURN_KEY_ID /
# CF_TURN_API_TOKEN take these same values at cutover.
SFU_APP_ID=caper
SFU_APP_SECRET=<openssl rand -hex 32>
SFU_TURN_KEY_ID=caper-turn
SFU_TURN_API_TOKEN=<openssl rand -hex 32>
# Shared only between caper-sfu and coturn on this host.
TURN_SECRET=<openssl rand -hex 32>
