+    public func probeSelection(_ phase: String, event: NSEvent? = nil) {
+        guard ProcessInfo.processInfo.environment["CAPER_PROBE_SELECTION"] == "1" else { return }
+        let range = selectedRange()
+        var record: [String: Any] = ["phase": phase, "time": Date().timeIntervalSince1970,
+            "location": range.location, "length": range.length, "text": string]
+        if let event {
+            let point = convert(event.locationInWindow, from: nil)
+            record["eventX"] = point.x; record["eventY"] = point.y
+        }
+        if phase == "select-all", range.length > 0 {
+            let glyph = firstRect(forCharacterRange: NSRange(location: range.location + range.length / 2, length: 1), actualRange: nil)
+            record["glyphX"] = glyph.midX
+            record["glyphY"] = (NSScreen.main?.frame.maxY ?? 0) - glyph.midY
+        }
+        guard let data = try? JSONSerialization.data(withJSONObject: record, options: [.sortedKeys]) else { return }
+        let url = URL(fileURLWithPath: "/tmp/caper-appkit-selection.jsonl")
+        if !FileManager.default.fileExists(atPath: url.path) { FileManager.default.createFile(atPath: url.path, contents: nil) }
+        if let file = try? FileHandle(forWritingTo: url) {
+            defer { try? file.close() }
+            _ = try? file.seekToEnd(); try? file.write(contentsOf: data + Data([10]))
+        }
+    }
