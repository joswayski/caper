+    private func probePlainFormatting(inside: Bool) async throws {
+        continueAfterFailure = false
+        try await Self.resetFixture()
+        let app = launch()
+        defer { app.terminate() }
+        let composer = app.textViews["message-composer"]
+        XCTAssertTrue(composer.waitForExistence(timeout: 15))
+        XCTAssertEqual(composer.value as? String, "")
+        composer.click(); composer.typeText("menu style")
+        XCTAssertEqual(composer.value as? String, "menu style", "Plain-text control starts without inherited delimiters")
+        composer.typeKey("a", modifierFlags: .command)
+        let lines = try String(contentsOfFile: "/tmp/caper-appkit-selection.jsonl", encoding: .utf8).split(separator: "\n")
+        let records = try lines.map { try JSONSerialization.jsonObject(with: Data($0.utf8)) as! [String: Any] }
+        let selected = try XCTUnwrap(records.last { $0["phase"] as? String == "select-all" })
+        XCTAssertEqual(selected["text"] as? String, "menu style")
+        XCTAssertEqual(selected["location"] as? Int, 0)
+        XCTAssertEqual(selected["length"] as? Int, 10)
+        let glyph = CGPoint(x: try XCTUnwrap(selected["glyphX"] as? Double), y: try XCTUnwrap(selected["glyphY"] as? Double))
+        XCTAssertTrue(composer.frame.contains(glyph))
+        let point = inside ? glyph : CGPoint(x: composer.frame.maxX - 20, y: composer.frame.midY)
+        XCTAssertGreaterThan(composer.frame.maxX - 20 - glyph.x, 100, "Blank control is well away from the selected glyph")
+        print("PROBE plain inside=\(inside) glyph=\(glyph) click=\(point) composer=\(composer.frame)")
+        capture("plain selection before context menu inside=\(inside)", app: app)
+        composer.coordinate(withNormalizedOffset: .zero).withOffset(CGVector(dx: point.x - composer.frame.minX, dy: point.y - composer.frame.minY)).rightClick()
+        let italic = composer.menuItems["I — Italic"]
+        XCTAssertTrue(italic.waitForExistence(timeout: 5))
+        capture("plain context menu inside=\(inside)", app: app)
+        composer.menuItems["B — Bold"].hover(); italic.hover(); italic.click()
+        print("PROBE plain after inside=\(inside) value=\(String(describing: composer.value))")
+        capture("plain after italic inside=\(inside)", app: app)
+        XCTAssertEqual(composer.value as? String, inside ? "_menu style_" : "menu style")
+    }
