+            if index > 0 { RunLoop.current.run(until: Date().addingTimeInterval(1)) }
+            print("PROBE AX sample=\(index) elapsed=\(Date().timeIntervalSince(start))")
+            for element in app.staticTexts.allElementsBoundByIndex {
+                print("PROBE AX elapsed=\(Date().timeIntervalSince(start)) id=\(element.identifier.debugDescription) label=\(element.label.debugDescription) value=\(String(describing: element.value)) frame=\(element.frame)")
+            }
+            print("PROBE AX prefix-label=\(app.staticTexts.matching(NSPredicate(format: "label BEGINSWITH %@", "Forwarded to 1 destination.")).count) prefix-value=\(app.staticTexts.matching(NSPredicate(format: "value BEGINSWITH %@", "Forwarded to 1 destination.")).count) elapsed=\(Date().timeIntervalSince(start))")
+        }
+        print("PROBE AX hierarchy \(app.debugDescription)")
+    }
