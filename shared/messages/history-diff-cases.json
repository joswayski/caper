      "new": [
        [
          "a",
          false
        ],
        [
          " c",
          true
        ]
      ]
    },
    {
      "note": "U+0085 and U+FEFF sit inside words and spaces",
      "before": "ab ﻿c",
      "after": "ad ﻿c",
      "old": [
        [
          "a",
          false
        ],
        [
          "b",
          true
        ],
        [
          " ﻿c",
          false
        ]
      ],
      "new": [
        [
          "a",
          false
        ],
        [
          "d",
          true
        ],
        [
          " ﻿c",
          false
        ]
      ]
    },
    {
      "note": "a lone carriage return is its own token",
      "before": "a\rb",
      "after": "a\rc",
