      ],
      "new": [
        [
          "a\r",
          false
        ],
        [
          "c",
          true
        ]
      ]
    },
    {
      "note": "Markdown delimiters compare as written",
      "before": "**bold** and _it_",
      "after": "**bold** or _it_",
      "old": [
        [
          "**bold** ",
          false
        ],
        [
          "and",
          true
        ],
        [
          " _it_",
          false
        ]
      ],
      "new": [
        [
          "**bold** ",
          false
        ],
        [
          "or",
          true
        ],
        [
          " _it_",
          false
        ]
      ]
    },
    {
      "note": "repeated words take jsdiff's path",
      "before": "the the the cat",
      "after": "the cat the the",
      "old": [
        [
          "the ",
          false
        ],
        [
          "the",
          true
        ],
        [
          " the ",
          false
        ],
        [
          "cat",
          true
