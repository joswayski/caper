{
  "description": "Which characters an edit-history comparison highlights, generated from web's MessageDiff (@pierre/diffs with lineDiffType \"word\" over jsdiff 9.0.0): lines are diffed first, each changed line paired with its counterpart is diffed by words, and a changed line without a counterpart is highlighted whole. Each side is a list of [text, highlighted] runs covering the whole text. Every client's tests must produce exactly these runs; see shared/messages/history_diff.rs.",
  "cases": [
    {
      "note": "an inserted word",
      "before": "see you there",
      "after": "see you over there",
      "old": [
        [
          "see you there",
          false
        ]
      ],
      "new": [
        [
          "see you ",
          false
        ],
        [
          "over ",
          true
        ],
        [
          "there",
          false
        ]
      ]
    },
    {
      "note": "a removed word",
      "before": "see you over there",
      "after": "see you there",
      "old": [
        [
          "see you ",
          false
        ],
        [
          "over ",
          true
        ],
        [
          "there",
          false
        ]
      ],
      "new": [
        [
          "see you there",
          false
        ]
      ]
    },
    {
      "note": "a replaced word keeps the spaces around it",
      "before": "meet at 5pm today",
      "after": "meet at 6pm today",
      "old": [
        [
          "meet at ",
          false
        ],
        [
          "5pm",
          true
        ],
        [
          " today",
          false
        ]
      ],
      "new": [
        [
          "meet at ",
          false
        ],
        [
          "6pm",
          true
        ],
        [
          " today",
          false
        ]
      ]
    },
    {
      "note": "identical text has no highlights",
      "before": "nothing changed",
      "after": "nothing changed",
      "old": [
        [
          "nothing changed",
          false
        ]
      ],
      "new": [
        [
          "nothing changed",
          false
        ]
      ]
    },
    {
      "note": "a whole replacement",
      "before": "yes",
      "after": "no",
      "old": [
        [
          "yes",
          true
        ]
      ],
      "new": [
        [
          "no",
          true
        ]
      ]
    },
    {
      "note": "punctuation is its own token",
      "before": "done.",
      "after": "done!",
      "old": [
        [
          "done",
          false
        ],
        [
          ".",
          true
        ]
      ],
      "new": [
        [
          "done",
          false
        ],
        [
          "!",
          true
        ]
      ]
    },
    {
      "note": "each emoji is its own token",
      "before": "nice 👍",
      "after": "nice 👍🏽 🙂",
      "old": [
        [
          "nice 👍",
          false
        ]
      ],
      "new": [
        [
          "nice 👍",
          false
        ],
        [
          "🏽 🙂",
          true
        ]
      ]
    },
    {
      "note": "Latin letters with diacritics are word characters",
      "before": "café crème",
      "after": "café brûlée",
      "old": [
        [
          "café ",
          false
        ],
        [
          "crème",
          true
        ]
      ],
      "new": [
        [
          "café ",
          false
        ],
        [
          "brûlée",
          true
        ]
      ]
    },
    {
      "note": "× and ˇ are not word characters",
      "before": "2×3 ˇx",
      "after": "2×4 ˇy",
      "old": [
        [
          "2×",
          false
        ],
        [
          "3",
          true
        ],
        [
          " ˇ",
          false
        ],
        [
          "x",
          true
        ]
      ],
      "new": [
        [
          "2×",
          false
        ],
        [
          "4",
          true
        ],
        [
          " ˇ",
          false
        ],
        [
          "y",
          true
        ]
      ]
    },
    {
      "note": "other scripts change one character at a time",
      "before": "日本語です",
      "after": "日本人です",
      "old": [
        [
          "日本",
          false
        ],
        [
          "語",
          true
        ],
        [
          "です",
          false
        ]
      ],
      "new": [
        [
          "日本",
          false
        ],
        [
          "人",
          true
        ],
        [
          "です",
          false
        ]
      ]
    },
    {
      "note": "a run of other white space is one token",
      "before": "a 　b",
