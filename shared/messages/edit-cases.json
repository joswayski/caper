{
  "description": "Geometry of attachment edits (crop, rotate, drawing and text before sending). Every client's tests must produce exactly these results, within 1e-9 for fractions. Edits are fractions of the rotated, uncropped image: crop and mark positions of its width and height, stroke widths and text sizes of its longer edge. See apps/web/src/chat/edit.ts and docs/media.md#editing-attachments-before-sending.",
  "rotateLeft": [
    {
      "note": "an unedited file turns a quarter anticlockwise",
      "before": { "rotation": 0, "crop": { "x": 0, "y": 0, "width": 1, "height": 1 }, "marks": [] },
      "after": { "rotation": 270, "crop": { "x": 0, "y": 0, "width": 1, "height": 1 }, "marks": [] }
    },
    {
      "note": "rotation wraps from a quarter anticlockwise to upside down",
      "before": { "rotation": 270, "crop": { "x": 0, "y": 0, "width": 1, "height": 1 }, "marks": [] },
      "after": { "rotation": 180, "crop": { "x": 0, "y": 0, "width": 1, "height": 1 }, "marks": [] }
    },
    {
      "note": "the crop turns with the picture",
      "before": { "rotation": 90, "crop": { "x": 0.1, "y": 0.2, "width": 0.5, "height": 0.3 }, "marks": [] },
      "after": { "rotation": 0, "crop": { "x": 0.2, "y": 0.4, "width": 0.3, "height": 0.5 }, "marks": [] }
    },
    {
      "note": "drawings and text move with the picture; widths, sizes and text stay upright",
      "before": {
        "rotation": 0,
        "crop": { "x": 0, "y": 0, "width": 1, "height": 1 },
        "marks": [
          { "kind": "stroke", "color": "#E5484D", "width": 0.01, "points": [0.1, 0.2, 0.3, 0.4] },
          { "kind": "text", "color": "#FFFFFF", "size": 0.05, "x": 0.25, "y": 0.75, "text": "Look" }
        ]
      },
      "after": {
        "rotation": 270,
        "crop": { "x": 0, "y": 0, "width": 1, "height": 1 },
        "marks": [
          { "kind": "stroke", "color": "#E5484D", "width": 0.01, "points": [0.2, 0.9, 0.4, 0.7] },
          { "kind": "text", "color": "#FFFFFF", "size": 0.05, "x": 0.75, "y": 0.75, "text": "Look" }
        ]
      }
    }
  ],
  "cropPixels": [
    {
      "note": "no crop keeps every pixel",
      "width": 4000,
      "height": 3000,
      "rotation": 0,
      "crop": { "x": 0, "y": 0, "width": 1, "height": 1 },
      "even": false,
      "expected": { "left": 0, "top": 0, "width": 4000, "height": 3000 }
    },
    {
      "note": "a quarter turn swaps the edges",
      "width": 4000,
      "height": 3000,
      "rotation": 90,
      "crop": { "x": 0, "y": 0, "width": 1, "height": 1 },
      "even": false,
      "expected": { "left": 0, "top": 0, "width": 3000, "height": 4000 }
    },
    {
      "note": "edges round to the nearest pixel",
      "width": 1001,
      "height": 1001,
      "rotation": 0,
      "crop": { "x": 0.25, "y": 0.25, "width": 0.5, "height": 0.5 },
      "even": false,
      "expected": { "left": 250, "top": 250, "width": 501, "height": 501 }
    },
    {
      "note": "video crops start and measure on even pixels",
      "width": 1001,
      "height": 1001,
      "rotation": 0,
      "crop": { "x": 0.25, "y": 0.25, "width": 0.5, "height": 0.5 },
      "even": true,
      "expected": { "left": 250, "top": 250, "width": 500, "height": 500 }
    },
    {
      "note": "a rotated landscape video cropped to its left half",
      "width": 1920,
      "height": 1080,
      "rotation": 270,
      "crop": { "x": 0.1, "y": 0, "width": 0.5, "height": 1 },
      "even": true,
      "expected": { "left": 108, "top": 0, "width": 540, "height": 1920 }
    },
    {
      "note": "a sliver at the edge keeps at least one pixel",
      "width": 100,
      "height": 100,
      "rotation": 0,
      "crop": { "x": 0.9999, "y": 0.9999, "width": 0.0001, "height": 0.0001 },
      "even": false,
      "expected": { "left": 99, "top": 99, "width": 1, "height": 1 }
    },
    {
      "note": "a video sliver at the edge keeps at least two pixels",
      "width": 100,
      "height": 100,
      "rotation": 0,
      "crop": { "x": 0.9999, "y": 0.9999, "width": 0.0001, "height": 0.0001 },
      "even": true,
      "expected": { "left": 98, "top": 98, "width": 2, "height": 2 }
    }
  ],
  "edited": [
    { "note": "untouched", "edit": { "rotation": 0, "crop": { "x": 0, "y": 0, "width": 1, "height": 1 }, "marks": [] }, "edited": false },
    { "note": "turned", "edit": { "rotation": 180, "crop": { "x": 0, "y": 0, "width": 1, "height": 1 }, "marks": [] }, "edited": true },
    {
      "note": "cropped",
      "edit": { "rotation": 0, "crop": { "x": 0, "y": 0, "width": 0.5, "height": 1 }, "marks": [] },
      "edited": true
    },
    {
      "note": "drawn on",
      "edit": {
        "rotation": 0,
        "crop": { "x": 0, "y": 0, "width": 1, "height": 1 },
        "marks": [{ "kind": "stroke", "color": "#000000", "width": 0.01, "points": [0.5, 0.5] }]
      },
      "edited": true
    }
  ]
}
