{
  "name": "caper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/staging.mjs",
    "dev:web": "npm run dev --workspace @caper/web",
    "secrets:check": "node scripts/secrets-check.mjs",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace @caper/web",
    "start:web": "npm run start --workspace @caper/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "vitest run --project native",
    "test:cdn": "vitest run --project cdn",
    "typecheck": "npm run typecheck --workspace @caper/web",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "npm run lint -- --fix",
    "fmt": "oxfmt --write \"**/*.{js,mjs,cjs,ts,tsx,css}\" \"**/package.json\" \"**/tsconfig*.json\" \".ox*.json\"",
    "fmt:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx,css}\" \"**/package.json\" \"**/tsconfig*.json\" \".ox*.json\"",
    "check": "npm run lint && npm run fmt:check && npm run build:web"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "vitest": "5.0.3"
  }
}
